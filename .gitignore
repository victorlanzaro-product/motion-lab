# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# uv
uv.lock

# Motion Lab data — training samples, events and trained models are local-only.
data/training/*
data/events/*
!data/training/.gitkeep
!data/events/.gitkeep
backend/models/*.joblib
backend/models/*.html

# Third-party pose model (5.5 MB), re-downloaded by ensure_model() on demand.
models/*.task

# Media must never be committed: the spec forbids storing video.
*.mp4
*.mov
*.avi
*.png
*.jpg
# Exact synthetic UI proof only; keep all other media ignored.
!demos/museum-installation/evidence/01-evento-aceito.png
!demos/museum-installation/evidence/02-abaixo-do-limiar.png
!demos/museum-installation/evidence/03-pausada-apos-evento.png
!demos/museum-installation/evidence/04-retomada.png
!demos/museum-installation/evidence/05-reiniciada.png

# macOS
.DS_Store
